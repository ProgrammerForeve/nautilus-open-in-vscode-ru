# Maintainer: ProgrammerForeve <https://github.com/ProgrammerForeve>

pkgname=nautilus-open-in-vscode-ru-git
pkgver=r1.0
pkgrel=1
pkgdesc="Расширение для Nautilus: добавляет пункт «🔷 Открыть в VS Code» в контекстное меню"
arch=('any')
url="https://github.com/ProgrammerForeve/nautilus-open-in-vscode-ru/"
license=('Unlicense')
depends=('python-nautilus')
makedepends=('git')
provides=('code-nautilus' 'nautilus-open-in-vscode-ru')
conflicts=('code-nautilus' 'code-nautilus-git')
install="code-nautilus-git.install"
source=("${pkgname}::git+https://github.com/ProgrammerForeve/nautilus-open-in-vscode-ru.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm644 code-nautilus.py "$pkgdir/usr/share/nautilus-python/extensions/code-nautilus.py"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
